{
  "name": "moxbnb-backend",
  "version": "1.0.0",
  "description": "Backend API for Moxbnb platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon -x ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc",
    "start": "node -r tsconfig-paths/register dist/index.js",
    "install": "npm run build",
    "vercel-build": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "seed": "npm run seed:users && npm run seed:marketplace",
    "seed:users": "ts-node -r tsconfig-paths/register scripts/seed-users.ts",
    "seed:marketplace": "ts-node -r tsconfig-paths/register scripts/seed-marketplace.ts",
    "seed:reviews": "ts-node -r tsconfig-paths/register scripts/seed-reviews.ts",
    "seed:admin": "ts-node -r tsconfig-paths/register scripts/seed-admin-accounts.ts",
    "seed:admin:force": "ts-node -r tsconfig-paths/register scripts/seed-admin-accounts.ts --force-delete"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "moxbnb",
    "rental",
    "booking",
    "api",
    "nodejs",
    "typescript",
    "mongodb"
  ],
  "author": "Moxbnb Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "mongoose-paginate-v2": "^1.8.0",
    "mongoose-sequence": "^5.3.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.7",
    "redis": "^4.6.10",
    "socket.io": "^4.7.4",
    "stripe": "^14.9.0",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.30",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "@vercel/node": "^3.2.29",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
